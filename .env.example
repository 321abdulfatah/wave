# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. .env.local is gitignored and must stay that
# way — the values below are live credentials for a device on someone's house.
# ---------------------------------------------------------------------------

# --- Fast path: Ring Developer Playground ----------------------------------
# One-click token from https://developer.amazon.com/ring/console/playground
# Valid ~30 minutes. Needs no app, no account linking, no subscription, no
# device. Leave empty to run WAVE in mock mode with a scripted visitor.
RING_ACCESS_TOKEN=

RING_API_BASE=https://api.amazonvision.com


# --- Full path: your registered Ring app -----------------------------------
# From the Ring Developer Console "App credentials" page. Shown once — keep the
# CSV somewhere safe outside this repo.

# Public identifier, sent in OAuth token requests.
RING_CLIENT_ID=

# Confidential. Pairs with the client id to exchange an authorization code for
# an access token at https://oauth.ring.com/oauth/token.
RING_CLIENT_SECRET=

# The "HMAC Signature Key" from the same page. Ring signs every webhook with
# it and sends the digest in the X-Signature header; lib/ring/client.ts
# verifies that in constant time before any event is trusted. Without this set
# to the real key, WAVE will accept unsigned webhooks — fine on localhost,
# never anywhere else.
RING_WEBHOOK_SECRET=dev-secret-change-me


# --- AWS (AWS Builder mini challenge) --------------------------------------
# Unset -> the deterministic policy engine in lib/agent/policy.ts runs alone,
# which is the default and works offline.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-5
