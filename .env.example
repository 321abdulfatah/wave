# Ring Developer Playground token (developer.ring.com -> Playground).
# Leave empty to run WAVE in mock mode with a scripted visitor scenario.
RING_ACCESS_TOKEN=

# Base URL for the Ring Partner API.
RING_API_BASE=https://api.amazonvision.com

# Shared secret Ring signs webhooks with (X-Signature, HMAC-SHA256).
RING_WEBHOOK_SECRET=dev-secret-change-me

# Amazon Bedrock (AWS Builder mini challenge). Unset -> deterministic local policy engine.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-5
